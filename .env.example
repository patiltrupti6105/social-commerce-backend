# ─────────────────────────────────────────────────────────────────
# social-commerce-backend — Environment Variables
#
# RAILWAY DEPLOYMENT:
#   Copy every variable below into your Railway service's
#   "Variables" tab. Railway injects them as real env vars
#   at runtime — never commit the actual values to git.
#
# LOCAL DOCKER (docker-compose):
#   These are already set inline in docker-compose.yml.
#   You only need this file if you want to override them.
# ─────────────────────────────────────────────────────────────────


# ── MySQL ─────────────────────────────────────────────────────
# On Railway: copy the JDBC_URL from your MySQL plugin dashboard.
# It will look like: jdbc:mysql://containers-us-west-XX.railway.app:PORT/railway
DB_URL=jdbc:mysql://localhost:3306/socialcommerce?useSSL=false&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=root

# Hibernate DDL mode.
# Use 'validate' when Flyway owns the schema (recommended).
# Use 'none' if you want to skip the startup entity-check entirely.
DDL_AUTO=validate

# Flyway baseline — set to 'true' ONLY on the very first deploy
# against a pre-existing DB that has no flyway_schema_history table.
# Set back to 'false' after the first successful boot.
FLYWAY_BASELINE=false


# ── MongoDB ───────────────────────────────────────────────────
# On Railway: copy the Mongo connection string from your MongoDB plugin.
# On Atlas:   mongodb+srv://user:pass@cluster.mongodb.net/socialcommerce
MONGO_URI=mongodb://localhost:27017/socialcommerce


# ── JWT ───────────────────────────────────────────────────────
# Generate a secure secret (minimum 32 characters). Example command:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=REPLACE_WITH_A_RANDOM_STRING_AT_LEAST_32_CHARS_LONG
# Access token lifetime in ms  (900000  = 15 minutes)
JWT_EXPIRATION=900000
# Refresh token lifetime in ms (604800000 = 7 days)
JWT_REFRESH_EXPIRATION=604800000


# ── CORS ──────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# On Railway: set to your frontend Railway service URL.
# Example:    https://social-commerce-frontend.up.railway.app
CORS_ORIGINS=http://localhost:3000,http://localhost:5173


# ── Server ────────────────────────────────────────────────────
# Railway sets $PORT automatically — leave this as-is.
PORT=8080


# ── Public base URL ───────────────────────────────────────────
# Used when building absolute URLs (e.g. password-reset links).
# On Railway: set to your backend Railway service URL.
# Example:    https://social-commerce-backend.up.railway.app
BASE_URL=http://localhost:8080


# ── File storage ──────────────────────────────────────────────
# 'local'  → files saved to UPLOAD_DIR inside the container
#            (data is lost on redeploy unless you mount a volume)
# 's3'     → files saved to AWS S3 (recommended for production)
STORAGE_MODE=local
UPLOAD_DIR=uploads


# ── AWS S3 (only required when STORAGE_MODE=s3) ───────────────
AWS_S3_BUCKET=your-bucket-name
AWS_S3_REGION=us-east-1
# Never put real keys here — set them directly in Railway's UI.
AWS_ACCESS_KEY_ID=REPLACE_ME
AWS_SECRET_ACCESS_KEY=REPLACE_ME


# ── Pagination ────────────────────────────────────────────────
DEFAULT_PAGE_SIZE=20
NOTIFICATION_PAGE_SIZE=30
