# ── Git ──────────────────────────────────────────────────────
.git
.gitignore
.gitattributes

# ── IDE / Editor ─────────────────────────────────────────────
.idea
.vscode
*.iml
.classpath
.project
.factorypath
.settings

# ── Maven build output ───────────────────────────────────────
# The multi-stage Dockerfile builds inside the container,
# so local target/ is never needed in the build context.
target/

# ── Local environment files ──────────────────────────────────
.env
.env.local
.env.*.local

# ── OS noise ─────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Docker files themselves (not needed inside the image) ────
Dockerfile
docker-compose*.yml

# ── Docs ─────────────────────────────────────────────────────
README.md
HELP.md
*.md

# ── Uploaded files (runtime data, not source) ────────────────
uploads/

# ── Test reports ─────────────────────────────────────────────
**/surefire-reports/
**/failsafe-reports/
